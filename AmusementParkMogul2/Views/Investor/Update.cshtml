@model IEnumerable<AmusementParkMogul2.Models.Investor>

@{
    ViewData["Title"] = "Pick Investor";
}

<h1>Select an Investor</h1>

<div class="container mt-4">
    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var investor in Model)
            {
                <div class="col-md-5 mb-5">
                    <form asp-action="Update" method="post">
                        <input type="hidden" name="id" value="@investor.InvestorID" />
                        <button type="submit" >
                            <div class="card @(investor.Chosen ? "border border-success border-5" : "")" onclick="submitForm('@investor.InvestorID')">
                        <img src="@Url.Content(investor.Picture)" class="card-img-top" alt="@investor.Name" style="height: 200px; object-fit: cover;">
                        <div class="card-body ">
                            <h5 class="card-title">@investor.Name</h5>
                            <p class="card-text">Investment Amount: @investor.InvestmentTotal.ToString("C")</p>
                            <p class="card-text">Chosen: @investor.Chosen</p>
                        </div>
                        </div>
                        </button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning">No investors available.</div>
        }
    </div>
</div>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function submitForm(investorId) {
            document.getElementById('form-' + investorId).submit();
        }
    </script>
}