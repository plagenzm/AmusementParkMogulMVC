@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Amusement Park Mogul</h1>

    

    @using (Html.BeginForm("Create", "Park", FormMethod.Post))

    {
        @Html.ActionLink("Build Park", "Create", "Park", null, new { @class = "btn btn-lg btn-primary" })
    }

    

    <div class="row pt-3">

        <div class="col-3"></div>

        <div class="col-6" >
            <div id="imageContainer">
                <img id="displayImage" src="~/img/home-image.png" alt="Default Image" class="w-100" />
            </div>

        </div>

        <div class="col-3"></div>

     </div>

    </div>


    
</div>
