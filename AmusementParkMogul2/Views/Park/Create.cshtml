@model AmusementParkMogul2.Models.Park

@{
    ViewData["Title"] = "Create Park";
}


<h2>Create a Park</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-6">

        @using (Html.BeginForm("Create", "Park", FormMethod.Post))
        {
            <div class="form-group pt-3">
                <label for="Name">Park Name</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Park Name" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
            </div>

            <div class="form-group pt-3">
                <label for="Theme">Park Theme</label>
                <select name="Theme" id="ThemeSelect" onchange="changeImage()" class="form-select form-select-lg mb-3 ">
                    <option selected>Pick a park theme</option>
                    <option value="Wild West">Wild West</option>
                    <option value="Terror Trails">Terror Trails</option>
                    <option value="Adventure Island">Adventure Island</option>
                </select>
                @Html.ValidationMessageFor(m => m.Theme, "", new { @class = "text-danger" })
            </div>

            <div class="form-group pt-3">
                <label for="TicketPrice" class="form-label">Pick your ticket price:</label>
                <select name="TicketPrice" id="TicketPrice" class="form-select form-select-lg mb-3 ">
                    <option selected>Pick a ticket price</option>
                    <option value=100>$100</option>
                    <option value=200>$200</option>
                    <option value=300>$300</option>
                </select>
            </div>





            <button type="submit" class="btn btn-primary">Create Park</button>

        }

    </div>

    <div class="col-4">
        <div id="imageContainer">
            <img id="displayImage" src="~/img/park-horror.png" alt="Default Image" class="w-100" />
        </div>

    </div>

</div>



