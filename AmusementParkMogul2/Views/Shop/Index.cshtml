@model List<AmusementParkMogul2.Models.Shop>

@{
    ViewData["Title"] = "List of Shops";
}

<div class="text-center">
    <h1 class="display-4">Shops</h1>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Shops</th>
                <th>Size</th>
                <th>Purchase Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var shop in Model)
            {
                <tr>
                    <td>@shop.AttractionID</td>
                    <td>@shop.Name</td>
                    <td>@shop.Size</td>
                    <td>@shop.AttractionCost.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
